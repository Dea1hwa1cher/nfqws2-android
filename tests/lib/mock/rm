#!/bin/sh
# Mock rm for the regression tests.
#
# On this machine `rm` is a safe-delete wrapper: it can prompt, and a single
# `rm -rf` of a three-file directory measured ~7 s. The module calls rm on
# almost every code path (state files, chain files, temp files), so using the
# real one makes the suite slow and occasionally wedged in the EXIT trap.
# What the tests verify is that the module's files are gone afterwards, not how
# rm is implemented — so this is a plain, fast, non-interactive replacement.

force=0
recursive=0
paths=""

[ -n "$MOCK_DIR" ] && printf '%s\n' "$*" >> "$MOCK_DIR/rm.log" 2>/dev/null

for a in "$@"; do
  case "$a" in
    --) ;;
    -*) case "$a" in *f*) force=1 ;; esac
        case "$a" in *r*|*R*) recursive=1 ;; esac ;;
    *) paths="$paths $a" ;;
  esac
done

rc=0
for p in $paths; do
  [ -e "$p" ] || continue
  if [ -d "$p" ]; then
    if [ "$recursive" = 1 ]; then
      find "$p" -delete 2>/dev/null || rc=1
    else
      rmdir "$p" 2>/dev/null || rc=1
    fi
  else
    unlink "$p" 2>/dev/null || rc=1
  fi
done

exit $rc
