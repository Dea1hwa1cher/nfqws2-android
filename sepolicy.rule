# sepolicy.rule — SELinux policies for nfqws2-android (Magisk / KernelSU / APatch / ReSukiSU)
# Format: allow <source> <target> <class> { <permissions> }

# Sockets and networking for root daemon and helper utilities
allow su su tcp_socket { create bind connect listen accept read write setopt getattr }
allow su su udp_socket { create bind connect listen accept read write setopt getattr }
allow su su rawip_socket { create bind connect read write setopt getattr }
allow su su netlink_netfilter_socket { create bind connect read write setopt getattr }
allow su su netlink_route_socket { create bind connect read write nlmsg_read nlmsg_write }

# Netd IPC and DNS resolving
allow su netd_service service_manager find
allow su netd binder call
allow su netd unix_stream_socket connectto
allow su netd fd use

# Network interfaces and raw access
allow su netif { read write }
allow su net_raw { read write }
allow su node tcp_socket node_bind
allow su node udp_socket node_bind
allow su port tcp_socket name_bind
allow su port udp_socket name_bind
